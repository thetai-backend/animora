# ==============================================================================
# ANIMORA Clinic — Biến môi trường mẫu (.env.example)
# Sao chép file này thành `.env` khi chạy cục bộ: cp .env.example .env
# ==============================================================================

# Kết nối cơ sở dữ liệu SQLite cục bộ (hoặc đổi sang PostgreSQL trên Production)
DATABASE_URL="file:./dev.db"

# Khóa bí mật ký JWT phiên đăng nhập (BẮT BUỘC thay đổi bằng chuỗi ngẫu nhiên mạnh trên Production)
AUTH_SECRET="replace-with-strong-random-secret-key"

# Địa chỉ gốc của ứng dụng
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 (tùy chọn — để trống để dùng chế độ thử nghiệm cục bộ)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cấu hình SMTP gửi Email OTP & nhắc lịch tái khám thật (tùy chọn)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Khởi tạo tài khoản Quản trị viên mặc định khi chạy `npm run db:seed` hoặc `npm run db:clean` (tùy chọn)
# ANIMORA_ADMIN_EMAIL="quanly@animora.vn"
# ANIMORA_ADMIN_PASSWORD="change-me-strong-password"
# ANIMORA_ADMIN_NAME="Quản trị viên ANIMORA"
